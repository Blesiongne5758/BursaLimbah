# ============================================
# SERVER CONFIGURATION
# ============================================
NODE_ENV=development
PORT=3000
API_URL=http://localhost:3000

# ============================================
# DATABASE
# ============================================
DATABASE_URL=postgresql://user:password@localhost:5432/bursalimbah

# ============================================
# REDIS
# ============================================
REDIS_URL=redis://localhost:6379

# ============================================
# JWT AUTHENTICATION
# ============================================
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_REFRESH_EXPIRES_IN=30d

# ============================================
# ENCRYPTION
# ============================================
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
LOCATION_ENCRYPTION_KEY=your-32-byte-hex-encryption-key-here

# ============================================
# CORS
# ============================================
CORS_ORIGIN=http://localhost:5173

# ============================================
# MIDTRANS PAYMENT GATEWAY
# ============================================
MIDTRANS_SERVER_KEY=your-midtrans-server-key
MIDTRANS_CLIENT_KEY=your-midtrans-client-key
MIDTRANS_IS_PRODUCTION=false

# ============================================
# CLOUDINARY STORAGE
# ============================================
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ============================================
# OPENAI API
# ============================================
OPENAI_API_KEY=sk-your-openai-api-key-here

# ============================================
# EMAIL (SMTP)
# ============================================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
EMAIL_FROM=noreply@bursalimbah.com

# ============================================
# SENTRY ERROR TRACKING
# ============================================
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project

# ============================================
# AWS S3 STORAGE
# ============================================
# AWS Credentials (get from AWS IAM)
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key

# S3 Buckets
# Public bucket: For listing photos, profile pictures (CDN served)
AWS_PUBLIC_BUCKET=bursalimbah-public
# Private bucket: For KYC docs, chat attachments (pre-signed URLs only)
AWS_PRIVATE_BUCKET=bursalimbah-private

# CloudFront Distribution (optional, for CDN)
# CLOUDFRONT_DOMAIN=your-cloudfront-domain.cloudfront.net

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=info
