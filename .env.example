# ============================================
# SUPABASE CONFIGURATION
# ============================================
# Get these from your Supabase project settings
# https://app.supabase.com/project/_/settings/api

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ============================================
# CLOUDINARY CONFIGURATION
# ============================================
# Get these from your Cloudinary dashboard
# https://cloudinary.com/console

VITE_CLOUDINARY_CLOUD_NAME=your-cloud-name
VITE_CLOUDINARY_UPLOAD_PRESET=your-unsigned-upload-preset
VITE_CLOUDINARY_API_KEY=your-api-key

# ============================================
# API CONFIGURATION (Optional - if using backend)
# ============================================
# VITE_API_URL=http://localhost:3000/api

# ============================================
# MAPS & LOCATION
# ============================================
# VITE_MAPBOX_TOKEN=pk.your_mapbox_token_here
# VITE_GOOGLE_MAPS_KEY=your_google_maps_key_here

# ============================================
# MONITORING & ANALYTICS
# ============================================
# VITE_SENTRY_DSN=https://your_sentry_dsn@sentry.io/project
# VITE_GA_ID=G-XXXXXXXXXX

# ============================================
# FEATURE FLAGS
# ============================================
VITE_ENABLE_AI_CHAT=true
VITE_ENABLE_ESCROW=true
VITE_ENABLE_KYC=true
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_CRYPTO_WALLET=false

# ============================================
# ENVIRONMENT
# ============================================
VITE_APP_ENV=development
VITE_APP_URL=http://localhost:3000
