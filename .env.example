# ============================================
# APPLICATION
# ============================================
VITE_APP_TITLE=BursaLimbah.com
VITE_APP_URL=https://bursalimbah.com

# ============================================
# API CONFIGURATION
# ============================================
# Development
VITE_API_URL=http://localhost:3000/api

# Production
# VITE_API_URL=https://api.bursalimbah.com

# ============================================
# MAPS & LOCATION
# ============================================
VITE_MAPBOX_TOKEN=pk.your_mapbox_token_here
VITE_GOOGLE_MAPS_KEY=your_google_maps_key_here

# ============================================
# MONITORING & ANALYTICS
# ============================================
VITE_SENTRY_DSN=https://your_sentry_dsn@sentry.io/project
VITE_GA_ID=G-XXXXXXXXXX
VITE_VERCEL_ANALYTICS_ID=your_vercel_analytics_id

# ============================================
# FEATURE FLAGS
# ============================================
VITE_ENABLE_AI_CHAT=true
VITE_ENABLE_ESCROW=true
VITE_ENABLE_KYC=true
VITE_ENABLE_ANALYTICS=true

# ============================================
# ENVIRONMENT
# ============================================
NODE_ENV=production
VITE_ENVIRONMENT=production
